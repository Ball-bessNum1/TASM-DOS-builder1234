@ECHO OFF
ECHO.
ECHO ========================================
ECHO          TASM BUILD MODE
ECHO ========================================
ECHO.

A:
ECHO [1/4] Assembling MAIN.ASM...
TASM A:\MAINCOM.ASM
IF ERRORLEVEL 1 GOTO ERROR_ASM

ECHO.
ECHO [2/4] Linking MAIN.OBJ...
TLINK /x /t A:\MAINCOM.OBJ
IF ERRORLEVEL 1 GOTO ERROR_LINK

ECHO.
ECHO [3/4] Copying MAIN.EXE to C:...
COPY /Y A:\MAINCOM.COM C:\MAINCOM.COM
IF ERRORLEVEL 1 GOTO ERROR_COPY

ECHO.
ECHO [4/4] Running MAIN.EXE...
ECHO.
C:\MAINCOM.COM

ECHO.
ECHO BUILD FINISHED.
IF EXIST C:\HALT.EXE C:\HALT.EXE
GOTO END

:ERROR_ASM
ECHO.
ECHO ASSEMBLY ERROR.
IF EXIST C:\HALT.EXE C:\HALT.EXE
GOTO END

:ERROR_LINK
ECHO.
ECHO LINK ERROR.
IF EXIST C:\HALT.EXE C:\HALT.EXE
GOTO END

:ERROR_COPY
ECHO.
ECHO COPY ERROR.
IF EXIST C:\HALT.EXE C:\HALT.EXE

:END

@ECHO OFF
SET PATH=C:\TC;C:\TASM;%PATH%
ECHO.
ECHO ========================================
ECHO          TASM BUILD MODE
ECHO ========================================
ECHO.

A:
ECHO [1/4] Assembling MAIN.ASM...
TASM A:\MAIN.ASM
IF ERRORLEVEL 1 GOTO RETRY_ON_C

ECHO.
ECHO [2/4] Linking MAIN.OBJ...
TLINK A:\MAIN.OBJ
IF ERRORLEVEL 1 GOTO ERROR_LINK

ECHO.
ECHO [3/4] Copying MAIN.EXE to C:...
COPY /Y A:\MAIN.EXE C:\MAIN.EXE
IF ERRORLEVEL 1 GOTO ERROR_COPY

ECHO.
ECHO [4/4] Running MAIN.EXE...
ECHO.
C:\MAIN.EXE

ECHO.
ECHO BUILD FINISHED.
IF EXIST C:\HALT.EXE C:\HALT.EXE
GOTO END

:RETRY_ON_C
ECHO.
ECHO RETRING ON C... 
ECHO [1/3] Assembling and Linking...
TCC -IC:\TC -LC:\TC A:\MAIN.C
IF ERRORLEVEL 1 GOTO ERROR_ASM

ECHO.
ECHO [2/3] Copying MAIN.EXE to C:...
COPY /Y A:\MAIN.EXE C:\MAIN.EXE
IF ERRORLEVEL 1 GOTO ERROR_COPY

ECHO.
ECHO [3/3] Running MAIN.EXE...
ECHO.
C:\MAIN.EXE

ECHO.
ECHO BUILD FINISHED.
IF EXIST C:\HALT.EXE C:\HALT.EXE
GOTO END


:ERROR_ASM
ECHO.
ECHO ASSEMBLY ERROR.
IF EXIST C:\HALT.EXE C:\HALT.EXE
GOTO END

:ERROR_LINK
ECHO.
ECHO LINK ERROR.
IF EXIST C:\HALT.EXE C:\HALT.EXE
GOTO END

:ERROR_COPY
ECHO.
ECHO COPY ERROR.
IF EXIST C:\HALT.EXE C:\HALT.EXE

:END
